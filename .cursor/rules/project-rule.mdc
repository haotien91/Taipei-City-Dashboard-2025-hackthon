### 3. Pinia 狀態管理
```typescript
// stores/dashboard.ts
import { defineStore } from 'pinia'
import { ref, computed } from 'vue'
import type { Component, Dashboard } from '@/types'
import { useAPI } from '@/composables/useAPI'

export const useDashboardStore = defineStore('dashboard', () => {
  const components = ref<Component[]>([])
  const selectedDashboard = ref<Dashboard | null>(null)
  const isLoading = ref(false)
  
  const { api } = useAPI()
  
  // Computed
  const activeComponents = computed(() => 
    components.value.filter(c => c.isActive)
  )
  
  const componentsByType = computed(() => {
    const grouped: Record<string, Component[]> = {}
    components.value.forEach(component => {
      if (!grouped[component.type]) {
        grouped[component.type] = []
      }
      grouped[component.type].push(component)
    })
    return grouped
  })
  
  // Actions
  const fetchComponents = async () => {
    isLoading.value = true
    try {
      const response = await api.get('/api/v1/components')
      components.value = response.data
    } catch (error) {
      console.error('Failed to fetch components:', error)
    } finally {
      isLoading.value = false
    }
  }
  
  const addComponent = async (componentData: Partial<Component>) => {
    try {
      const response = await api.post('/api/v1/components', componentData)
      components.value.push(response.data)
      return response.data
    } catch (error) {
      console.error('Failed to add component:', error)
      throw error
    }
  }
  
  const updateComponent = async (id: string, updates: Partial<Component>) => {
    try {
      const response = await api.patch(`/api/v1/components/${id}`, updates)
      const index = components.value.findIndex(c => c.id === id)
      if (index !== -1) {
        components.value[index] = response.data
      }
      return response.data
    } catch (error) {
      console.error('Failed to update component:', error)
      throw error
    }
  }
  
  const deleteComponent = async (id: string) => {
    try {
      await api.delete(`/api/v1/components/${id}`)
      components.value = components.value.filter(c => c.id !== id)
    } catch (error) {
      console.error('Failed to delete component:', error)
      throw error
    }
  }
  
  return {
    // State
    components,
    selectedDashboard,
    isLoading,
    
    // Computed
    activeComponents,
    componentsByType,
    
    // Actions
    fetchComponents,
    addComponent,
    updateComponent,
    deleteComponent
  }
})
```

### 4. 地圖整合 (Mapbox)
```typescript
// composables/useMap.ts
import { ref, onMounted, onUnmounted } from 'vue'
import mapboxgl from 'mapbox-gl'
import type { Map, MapLayerConfig } from '@/types'

export function useMap(containerId: string) {
  const map = ref<mapboxgl.Map | null>(null)
  const isLoaded = ref(false)
  const layers = ref<MapLayerConfig[]>([])
  
  const initMap = () => {
    mapboxgl.accessToken = import.meta.env.VITE_MAPBOX_TOKEN
    
    map.value = new mapboxgl.Map({
      container: containerId,
      style: 'mapbox://styles/mapbox/dark-v11',
      center: [121.5654, 25.0330], // 台北市中心
      zoom: 11,
      pitch: 45,
      bearing: 0
    })
    
    map.value.on('load', () => {
      isLoaded.value = true
    })
    
    // 加入控制項
    map.value.addControl(new mapboxgl.NavigationControl())
    map.value.addControl(new mapboxgl.FullscreenControl())
  }
  
  const addLayer = (layerConfig: MapLayerConfig) => {
    if (!map.value || !isLoaded.value) return
    
    // 添加資料源
    if (layerConfig.source) {
      map.value.addSource(layerConfig.id, layerConfig.source)
    }
    
    // 添加圖層
    map.value.addLayer({
      id: layerConfig.id,
      type: layerConfig.type,
      source: layerConfig.source?.type === 'geojson' ? layerConfig.id : layerConfig.source,
      paint: layerConfig.paint,
      layout: layerConfig.layout
    })
    
    layers.value.push(layerConfig)
  }
  
  const removeLayer = (layerId: string) => {
    if (!map.value) return
    
    if (map.value.getLayer(layerId)) {
      map.value.removeLayer(layerId)
    }
    
    if (map.value.getSource(layerId)) {
      map.value.removeSource(layerId)
    }
    
    layers.value = layers.value.filter(layer => layer.id !== layerId)
  }
  
  const updateLayerData = (layerId: string, data: any) => {
    if (!map.value) return
    
    const source = map.value.getSource(layerId) as mapboxgl.GeoJSONSource
    if (source) {
      source.setData(data)
    }
  }
  
  const flyTo = (options: { center: [number, number]; zoom?: number }) => {
    if (!map.value) return
    
    map.value.flyTo({
      center: options.center,
      zoom: options.zoom || 12,
      duration: 1500
    })
  }
  
  onMounted(() => {
    initMap()
  })
  
  onUnmounted(() => {
    map.value?.remove()
  })
  
  return {
    map,
    isLoaded,
    layers,
    addLayer,
    removeLayer,
    updateLayerData,
    flyTo
  }
}
